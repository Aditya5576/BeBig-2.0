# ==============================================================================
# BeBig 2.0 — Environment Configuration Template
# ==============================================================================
#
# SECURITY RULES & ARCHITECTURE GUIDELINES:
# 1. Any variable prefixed with `EXPO_PUBLIC_` will be embedded directly into
#    the client application bundle. It is PUBLIC and accessible to anyone.
# 2. NEVER put secrets, service-role keys, private API keys, or database passwords
#    in this file or any mobile client environment file.
# 3. Server-only secrets (e.g., SUPABASE_SERVICE_ROLE_KEY) belong ONLY in your
#    secure backend/serverless functions, NEVER inside the mobile repository.
#
# ==============================================================================

# Application Environment ('development' | 'staging' | 'production')
EXPO_PUBLIC_APP_ENV=development

# Future API Base URL (Safe for mobile client)
EXPO_PUBLIC_API_URL=https://api.bebig.app/v1

# Future Supabase Client Settings (Safe for mobile client - public anon key ONLY)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-public-anon-key-here

# ------------------------------------------------------------------------------
# FORBIDDEN IN MOBILE CLIENT (DO NOT ADD TO MOBILE REPO OR .env):
# - SUPABASE_SERVICE_ROLE_KEY  --> Bypasses Row Level Security (RLS) - backend ONLY
# - WGER_API_KEY               --> Third-party provider key - backend ONLY
# - DATABASE_URL               --> Direct Postgres connection - backend ONLY
# - POSTGRES_PASSWORD          --> Database admin credentials - backend ONLY
# - APPLE_CLIENT_SECRET        --> OAuth client secret - backend ONLY
# - GOOGLE_CLIENT_SECRET       --> OAuth client secret - backend ONLY
# ------------------------------------------------------------------------------
