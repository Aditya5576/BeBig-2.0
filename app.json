{
  "expo": {
    "name": "BeBig",
    "slug": "bebig",
    "version": "2.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "bebig",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aditya.bebig",
      "userInterfaceStyle": "automatic",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSSupportsLiveActivities": true,
        "NSPhotoLibraryUsageDescription": "The app accesses your photos to let you attach photos to custom exercises."
      }
    },
    "android": {
      "package": "com.aditya.bebig",
      "userInterfaceStyle": "automatic",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#090D16",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-athlete.png",
          "resizeMode": "contain",
          "backgroundColor": "#090D16"
        }
      ],
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you attach photos to custom exercises."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#38BDF8"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5a1a611f-f4b5-4f32-abd1-134e02c0f5f9"
      }
    },
    "owner": "adityapatil009"
  }
}
